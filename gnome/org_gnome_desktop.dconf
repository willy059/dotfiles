[app-folders]
folder-children=['System', 'Utilities', 'YaST', 'Pardus', 'a3b31427-ad31-4bf6-a028-1dab1124c1cf', '7911ef3a-6a1d-40f5-b9f5-5419ffab3541']

[app-folders/folders/7911ef3a-6a1d-40f5-b9f5-5419ffab3541]
apps=['octopi.desktop', 'octopi-notifier.desktop', 'octopi-cachecleaner.desktop', 'octopi-repoeditor.desktop']
name='Dossier sans nom'

[app-folders/folders/Pardus]
categories=['X-Pardus-Apps']
name='X-Pardus-Apps.directory'
translate=true

[app-folders/folders/System]
apps=['org.gnome.baobab.desktop', 'org.gnome.DiskUtility.desktop', 'org.freedesktop.MalcontentControl.desktop', 'org.gnome.tweaks.desktop', 'org.cachyos.KernelManager.desktop', 'cachyos-pi.desktop', 'org.cachyos.scx-manager.desktop']
name='X-GNOME-Shell-System.directory'
translate=true

[app-folders/folders/Utilities]
apps=['org.gnome.Decibels.desktop', 'org.gnome.Papers.desktop', 'org.gnome.FileRoller.desktop', 'org.gnome.Loupe.desktop']
name='X-GNOME-Shell-Utilities.directory'
translate=true

[app-folders/folders/YaST]
categories=['X-SuSE-YaST']
name='suse-yast.directory'
translate=true

[app-folders/folders/a3b31427-ad31-4bf6-a028-1dab1124c1cf]
apps=['avahi-discover.desktop', 'bvnc.desktop', 'qv4l2.desktop', 'qvidcap.desktop', 'system-config-printer.desktop', 'bssh.desktop', 'lstopo.desktop', 'hplip.desktop', 'hp-uiscan.desktop']
name='Dossier sans nom'

[input-sources]
sources=[('xkb', 'fr')]

[interface]
color-scheme='prefer-dark'
cursor-size=32
cursor-theme='Bibata-Modern-Ice'
gtk-theme='adw-gtk3-dark'
icon-theme='Papirus'

[notifications]
application-children=['org-gnome-nautilus']

[notifications/application/org-gnome-nautilus]
application-id='org.gnome.Nautilus.desktop'

[peripherals/keyboard]
numlock-state=true

[peripherals/touchpad]
tap-to-click=true

[wm/preferences]
button-layout='appmenu:minimize,maximize,close'
